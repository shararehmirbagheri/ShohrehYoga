#:kivy 2.2.0

ScreenManager:
    HomeScreen:
        name: "home"
    StudentListScreen:
        name: "students"
    AttendanceScreen:
        name: "attendance"
    ReportScreen:
        name: "reports"

<HomeScreen>:
    BoxLayout:
        orientation: "vertical"
        spacing: 0
        canvas.before:
            Color:
                rgba: 0.97, 0.96, 0.99, 1
            Rectangle:
                pos: self.pos
                size: self.size

        BoxLayout:
            size_hint_y: None
            height: 72
            padding: [22, 10, 18, 10]
            canvas.before:
                Color:
                    rgba: 0.42, 0.16, 0.72, 1
                Rectangle:
                    pos: self.pos
                    size: self.size
            Label:
                text: "Dashboard"
                font_name: "Persian"
                font_size: 28
                bold: True
                color: 1, 1, 1, 1
                halign: "left"
                valign: "middle"
                text_size: self.size
            Widget:
            Label:
                text: "User: admin"
                font_name: "Persian"
                color: 1, 1, 1, 1
                size_hint_x: None
                width: 110

        BoxLayout:
            orientation: "vertical"
            padding: [55, 20, 55, 42]
            spacing: 18

            Image:
                source: "images/yoga_logo.png"
                size_hint_y: None
                height: 165
                allow_stretch: True
                keep_ratio: True

            Label:
                text: "Welcome to Shohreh Yoga Manager"
                font_name: "Persian"
                font_size: 24
                bold: True
                color: 0.20, 0.10, 0.28, 1
                size_hint_y: None
                height: 44

            GridLayout:
                cols: 3
                spacing: 24
                row_default_height: 145
                row_force_default: True

                Button:
                    text: "Manage Students"
                    font_name: "Persian"
                    font_size: 21
                    bold: True
                    background_normal: ""
                    background_color: 0.50, 0.20, 0.82, 1
                    color: 1, 1, 1, 1
                    on_release: root.manager.current = "students"

                Button:
                    text: "Attendance"
                    font_name: "Persian"
                    font_size: 21
                    bold: True
                    background_normal: ""
                    background_color: 0.50, 0.20, 0.82, 1
                    color: 1, 1, 1, 1
                    on_release: root.manager.current = "attendance"

                Button:
                    text: "Reports"
                    font_name: "Persian"
                    font_size: 21
                    bold: True
                    background_normal: ""
                    background_color: 0.50, 0.20, 0.82, 1
                    color: 1, 1, 1, 1
                    on_release: root.manager.current = "reports"

<StudentListScreen>:
    student_list: student_list
    student_count: student_count
    name_input: name_input
    phone_input: phone_input
    notes_input: notes_input
    receipt_input: receipt_input
    first_session_input: first_session_input
    sessions_paid_input: sessions_paid_input
    used_value: used_value
    remaining_value: remaining_value
    search_input: search_input

    BoxLayout:
        orientation: "vertical"
        spacing: 10
        padding: [14, 12, 14, 14]
        canvas.before:
            Color:
                rgba: 0.95, 0.93, 0.98, 1
            Rectangle:
                pos: self.pos
                size: self.size

        BoxLayout:
            size_hint_y: None
            height: 64
            padding: [14, 7, 12, 7]
            spacing: 12
            canvas.before:
                Color:
                    rgba: 0.42, 0.16, 0.72, 1
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [10]
            Image:
                source: "images/yoga_logo.png"
                size_hint_x: None
                width: 54
            Label:
                text: "Manage Students"
                font_name: "Persian"
                font_size: 24
                bold: True
                color: 1, 1, 1, 1
                halign: "left"
                valign: "middle"
                text_size: self.size
            Widget:
            Button:
                text: "Back"
                font_name: "Persian"
                size_hint_x: None
                width: 88
                background_normal: ""
                background_color: 0.62, 0.42, 0.78, 1
                color: 1, 1, 1, 1
                on_release: root.manager.current = "home"

        BoxLayout:
            orientation: "vertical"
            size_hint_y: None
            height: 220
            padding: [14, 12, 14, 12]
            spacing: 10
            canvas.before:
                Color:
                    rgba: 1, 1, 1, 1
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [12]

            GridLayout:
                cols: 6
                size_hint_y: None
                height: 42
                spacing: 8
                Label:
                    text: "Name"
                    font_name: "Persian"
                PersianTextInput:
                    id: name_input
                    font_name: "Persian"
                    font_size: 16
                    halign: "right"
                    multiline: False
                Label:
                    text: "Phone"
                    font_name: "Persian"
                TextInput:
                    id: phone_input
                    font_name: "Persian"
                    multiline: False
                Label:
                    text: "Receipt"
                    font_name: "Persian"
                Spinner:
                    id: receipt_input
                    text: "No"
                    values: ["Yes", "No"]
                    font_name: "Persian"
                    background_normal: ""
                    background_color: 1, 1, 1, 1
                    color: 0.2, 0.1, 0.28, 1

            GridLayout:
                cols: 6
                size_hint_y: None
                height: 42
                spacing: 8
                Label:
                    text: "First Session"
                    font_name: "Persian"
                BoxLayout:
                    spacing: 5
                    TextInput:
                        id: first_session_input
                        hint_text: "Select date"
                        font_name: "Persian"
                        readonly: True
                        multiline: False
                    Button:
                        text: "Calendar"
                        font_name: "Persian"
                        size_hint_x: None
                        width: 90
                        background_normal: ""
                        background_color: 0.50, 0.20, 0.82, 1
                        color: 1, 1, 1, 1
                        on_release: root.open_first_session_calendar()
                Label:
                    text: "Sessions Paid"
                    font_name: "Persian"
                TextInput:
                    id: sessions_paid_input
                    hint_text: "12"
                    input_filter: "int"
                    multiline: False
                Label:
                    text: "Notes"
                    font_name: "Persian"
                PersianTextInput:
                    id: notes_input
                    font_name: "Persian"
                    halign: "right"
                    multiline: False

            GridLayout:
                cols: 6
                size_hint_y: None
                height: 36
                Label:
                    text: "Used"
                    font_name: "Persian"
                Label:
                    id: used_value
                    text: "0"
                    font_name: "Persian"
                    bold: True
                Label:
                    text: "Remaining"
                    font_name: "Persian"
                Label:
                    id: remaining_value
                    text: "0"
                    font_name: "Persian"
                    bold: True
                Widget:
                Widget:

            BoxLayout:
                size_hint_y: None
                height: 38
                spacing: 10
                Widget:
                Button:
                    text: "Add"
                    font_name: "Persian"
                    background_normal: ""
                    background_color: 0.36, 0.64, 0.35, 1
                    on_release: root.add_student()
                Button:
                    text: "Update"
                    font_name: "Persian"
                    background_normal: ""
                    background_color: 0.50, 0.20, 0.82, 1
                    on_release: root.update_student()
                Button:
                    text: "Delete"
                    font_name: "Persian"
                    background_normal: ""
                    background_color: 0.86, 0.22, 0.26, 1
                    on_release: root.delete_student()
                Button:
                    text: "Clear"
                    font_name: "Persian"
                    background_normal: ""
                    background_color: 0.62, 0.42, 0.78, 1
                    on_release: root.clear_form()

        BoxLayout:
            size_hint_y: None
            height: 42
            spacing: 8
            PersianTextInput:
                id: search_input
                hint_text: "Search by ID, name, or phone"
                font_name: "Persian"
                halign: "right"
                multiline: False
                on_logical_text: root.schedule_search(self.logical_text)
            Label:
                text: "Filter"
                font_name: "Persian"
                size_hint_x: None
                width: 55
            Spinner:
                text: "All"
                values: ["All", "Receipt Yes", "Receipt No", "Renew Soon", "Zero or Negative"]
                size_hint_x: None
                width: 180
                background_normal: ""
                background_color: 1, 1, 1, 1
                color: 0.2, 0.1, 0.28, 1
                on_text: root.set_filter(self.text)
            Label:
                id: student_count
                text: "Students: 0"
                size_hint_x: None
                width: 120

        BoxLayout:
            orientation: "vertical"
            canvas.before:
                Color:
                    rgba: 1, 1, 1, 1
                Rectangle:
                    pos: self.pos
                    size: self.size

            BoxLayout:
                size_hint_y: None
                height: 44
                Button:
                    text: "ID"
                    size_hint_x: 0.06
                    on_release: root.sort_students("id")
                Button:
                    text: "Name"
                    size_hint_x: 0.23
                    on_release: root.sort_students("name")
                Button:
                    text: "Receipt"
                    size_hint_x: 0.10
                    on_release: root.sort_students("receipt")
                Button:
                    text: "First Session"
                    size_hint_x: 0.17
                    on_release: root.sort_students("first_session_date")
                Button:
                    text: "Paid"
                    size_hint_x: 0.11
                    on_release: root.sort_students("sessions_paid")
                Button:
                    text: "Used"
                    size_hint_x: 0.10
                    on_release: root.sort_students("sessions_used")
                Button:
                    text: "Remaining"
                    size_hint_x: 0.11
                    on_release: root.sort_students("remaining_sessions")
                Button:
                    text: "Phone"
                    size_hint_x: 0.12
                    on_release: root.sort_students("phone")

            ScrollView:
                do_scroll_x: False
                BoxLayout:
                    id: student_list
                    orientation: "vertical"
                    size_hint_y: None
                    height: self.minimum_height

<AttendanceScreen>:
    attendance_list: attendance_list
    selected_date_input: selected_date_input
    class_status_input: class_status_input
    present_count_label: present_count_label
    absent_count_label: absent_count_label
    total_count_label: total_count_label
    message_label: message_label

    BoxLayout:
        orientation: "vertical"
        spacing: 10
        padding: [14, 12, 14, 14]
        canvas.before:
            Color:
                rgba: 0.95, 0.93, 0.98, 1
            Rectangle:
                pos: self.pos
                size: self.size

        BoxLayout:
            size_hint_y: None
            height: 64
            padding: [14, 7, 12, 7]
            spacing: 12
            canvas.before:
                Color:
                    rgba: 0.42, 0.16, 0.72, 1
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [10]
            Image:
                source: "images/yoga_logo.png"
                size_hint_x: None
                width: 54
            Label:
                text: "Attendance"
                font_name: "Persian"
                font_size: 24
                bold: True
                color: 1, 1, 1, 1
                halign: "left"
                valign: "middle"
                text_size: self.size
            Widget:
            Button:
                text: "Back"
                font_name: "Persian"
                size_hint_x: None
                width: 88
                background_normal: ""
                background_color: 0.62, 0.42, 0.78, 1
                color: 1, 1, 1, 1
                on_release: root.manager.current = "home"

        BoxLayout:
            size_hint_y: None
            height: 58
            padding: [12, 8, 12, 8]
            spacing: 8
            canvas.before:
                Color:
                    rgba: 1, 1, 1, 1
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [10]
            Label:
                text: "Attendance Date"
                font_name: "Persian"
                color: 0.24, 0.12, 0.34, 1
                size_hint_x: None
                width: 120
            TextInput:
                id: selected_date_input
                readonly: True
                multiline: False
                font_name: "Persian"
                font_size: 17
                halign: "center"
                foreground_color: 0.16, 0.10, 0.23, 1
                background_color: 1, 1, 1, 1
                size_hint_x: None
                width: 150
            Button:
                text: "Calendar"
                size_hint_x: None
                width: 95
                background_normal: ""
                background_color: 0.50, 0.20, 0.82, 1
                on_release: root.open_calendar()
            Button:
                text: "Today"
                size_hint_x: None
                width: 80
                background_normal: ""
                background_color: 0.62, 0.42, 0.78, 1
                on_release: root.use_today()
            Label:
                text: "Class"
                size_hint_x: None
                width: 50
            Spinner:
                id: class_status_input
                text: "Class Held"
                values: ["Class Held", "Canceled Class", "Extra Class", "No Class"]
                size_hint_x: None
                width: 150
                background_normal: ""
                background_color: 1, 1, 1, 1
                color: 0.2, 0.1, 0.28, 1
                on_text: root.on_class_status_changed(self.text)
            Widget:
            Label:
                id: total_count_label
                text: "Students: 0"
                size_hint_x: None
                width: 100
            Label:
                id: present_count_label
                text: "Present: 0"
                size_hint_x: None
                width: 95
            Label:
                id: absent_count_label
                text: "Absent: 0"
                size_hint_x: None
                width: 95

        BoxLayout:
            size_hint_y: None
            height: 42
            spacing: 8
            Button:
                text: "Select All"
                background_normal: ""
                background_color: 0.36, 0.64, 0.35, 1
                on_release: root.select_all()
            Button:
                text: "Clear All"
                background_normal: ""
                background_color: 0.62, 0.42, 0.78, 1
                on_release: root.clear_all()
            Button:
                text: "Save Class"
                bold: True
                background_normal: ""
                background_color: 0.50, 0.20, 0.82, 1
                on_release: root.save_attendance()
            Button:
                text: "Backup"
                background_normal: ""
                background_color: 0.62, 0.42, 0.78, 1
                on_release: root.backup_database()

        Label:
            id: message_label
            text: ""
            size_hint_y: None
            height: 28
            color: 0.35, 0.18, 0.45, 1

        BoxLayout:
            orientation: "vertical"
            canvas.before:
                Color:
                    rgba: 1, 1, 1, 1
                Rectangle:
                    pos: self.pos
                    size: self.size
            BoxLayout:
                size_hint_y: None
                height: 44
                Button:
                    text: "Present"
                    size_hint_x: 0.12
                    on_release: root.sort_attendance("present")
                Button:
                    text: "Student Name"
                    size_hint_x: 0.63
                    on_release: root.sort_attendance("name")
                Button:
                    text: "Status"
                    size_hint_x: 0.25
                    on_release: root.sort_attendance("status")
            ScrollView:
                do_scroll_x: False
                BoxLayout:
                    id: attendance_list
                    orientation: "vertical"
                    size_hint_y: None
                    height: self.minimum_height

<ReportScreen>:
    from_date_input: from_date_input
    to_date_input: to_date_input
    report_message: report_message

    BoxLayout:
        orientation: "vertical"
        spacing: 12
        padding: [16, 14, 16, 16]
        canvas.before:
            Color:
                rgba: 0.95, 0.93, 0.98, 1
            Rectangle:
                pos: self.pos
                size: self.size

        BoxLayout:
            size_hint_y: None
            height: 64
            padding: [14, 7, 12, 7]
            spacing: 12
            canvas.before:
                Color:
                    rgba: 0.42, 0.16, 0.72, 1
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [10]
            Image:
                source: "images/yoga_logo.png"
                size_hint_x: None
                width: 54
            Label:
                text: "Reports"
                font_name: "Persian"
                font_size: 24
                bold: True
                color: 1, 1, 1, 1
                halign: "left"
                valign: "middle"
                text_size: self.size
            Widget:
            Button:
                text: "Back"
                size_hint_x: None
                width: 88
                background_normal: ""
                background_color: 0.62, 0.42, 0.78, 1
                on_release: root.manager.current = "home"

        BoxLayout:
            orientation: "vertical"
            padding: [28, 28, 28, 28]
            spacing: 22
            canvas.before:
                Color:
                    rgba: 1, 1, 1, 1
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [12]

            Label:
                text: "Attendance Matrix Report"
                font_size: 24
                bold: True
                color: 0.24, 0.12, 0.34, 1
                size_hint_y: None
                height: 50

            BoxLayout:
                size_hint_y: None
                height: 54
                spacing: 10
                Label:
                    text: "From Date"
                    font_name: "Persian"
                    color: 0.24, 0.12, 0.34, 1
                    size_hint_x: None
                    width: 90
                TextInput:
                    id: from_date_input
                    readonly: True
                    multiline: False
                    font_name: "Persian"
                    font_size: 17
                    halign: "center"
                    foreground_color: 0.16, 0.10, 0.23, 1
                    background_color: 1, 1, 1, 1
                Button:
                    text: "Calendar"
                    size_hint_x: None
                    width: 110
                    background_normal: ""
                    background_color: 0.62, 0.42, 0.78, 1
                    on_release: root.open_from_calendar()
                Label:
                    text: "To Date"
                    font_name: "Persian"
                    color: 0.24, 0.12, 0.34, 1
                    size_hint_x: None
                    width: 75
                TextInput:
                    id: to_date_input
                    readonly: True
                    multiline: False
                    font_name: "Persian"
                    font_size: 17
                    halign: "center"
                    foreground_color: 0.16, 0.10, 0.23, 1
                    background_color: 1, 1, 1, 1
                Button:
                    text: "Calendar"
                    size_hint_x: None
                    width: 110
                    background_normal: ""
                    background_color: 0.62, 0.42, 0.78, 1
                    on_release: root.open_to_calendar()

            BoxLayout:
                size_hint_y: None
                height: 60
                spacing: 16
                Button:
                    text: "Check Report"
                    font_size: 18
                    background_normal: ""
                    background_color: 0.50, 0.20, 0.82, 1
                    on_release: root.view_report()
                Button:
                    text: "Export Excel Matrix"
                    font_size: 18
                    bold: True
                    background_normal: ""
                    background_color: 0.36, 0.64, 0.35, 1
                    on_release: root.export_report()

            Label:
                id: report_message
                text: ""
                color: 0.24, 0.12, 0.34, 1
                size_hint_y: None
                height: 50

            Label:
                text: "Thursday and Friday are excluded. Canceled classes appear as gray columns. Extra classes are included."
                color: 0.35, 0.25, 0.42, 1
                size_hint_y: None
                height: 44

            Widget:
